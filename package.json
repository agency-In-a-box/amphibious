{
  "name": "@agency-in-a-box/amphibious",
  "version": "2.0.3",
  "description": "Modern responsive CSS framework and component library - the evolution of A.mphibio.us",
  "type": "module",
  "main": "./dist/amphibious.umd.js",
  "module": "./dist/amphibious.es.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/amphibious.es.js",
      "require": "./dist/amphibious.umd.js"
    },
    "./css": "./dist/amphibious.css",
    "./loaders": {
      "types": "./dist/src/loaders.d.ts",
      "import": "./dist/esm/loaders.js"
    },
    "./carousel": {
      "types": "./dist/src/entries/carousel.d.ts",
      "import": "./dist/esm/carousel.js"
    },
    "./modal": {
      "types": "./dist/src/entries/modal.d.ts",
      "import": "./dist/esm/modal.js"
    },
    "./forms": {
      "types": "./dist/src/entries/forms.d.ts",
      "import": "./dist/esm/forms.js"
    },
    "./tabs": {
      "types": "./dist/src/entries/tabs.d.ts",
      "import": "./dist/esm/tabs.js"
    },
    "./tooltip": {
      "types": "./dist/src/entries/tooltip.d.ts",
      "import": "./dist/esm/tooltip.js"
    },
    "./accordion": {
      "types": "./dist/src/entries/accordion.d.ts",
      "import": "./dist/esm/accordion.js"
    },
    "./toast": {
      "types": "./dist/src/entries/toast.d.ts",
      "import": "./dist/esm/toast.js"
    },
    "./smooth-scroll": {
      "types": "./dist/src/entries/smooth-scroll.d.ts",
      "import": "./dist/esm/smooth-scroll.js"
    },
    "./navigation": {
      "types": "./dist/src/entries/navigation.d.ts",
      "import": "./dist/esm/navigation.js"
    },
    "./dark-mode-toggle": {
      "types": "./dist/src/entries/dark-mode-toggle.d.ts",
      "import": "./dist/esm/dark-mode-toggle.js"
    },
    "./icons": {
      "types": "./dist/src/entries/icons.d.ts",
      "import": "./dist/esm/icons.js"
    },
    "./form-builder": {
      "types": "./dist/src/entries/form-builder.d.ts",
      "import": "./dist/esm/form-builder.js"
    },
    "./file-upload": {
      "types": "./dist/src/entries/file-upload.d.ts",
      "import": "./dist/esm/file-upload.js"
    },
    "./search-bar": {
      "types": "./dist/src/entries/search-bar.d.ts",
      "import": "./dist/esm/search-bar.js"
    },
    "./dropdown": {
      "types": "./dist/src/entries/dropdown.d.ts",
      "import": "./dist/esm/dropdown.js"
    },
    "./color-picker": {
      "types": "./dist/src/entries/color-picker.d.ts",
      "import": "./dist/esm/color-picker.js"
    },
    "./timeline": {
      "types": "./dist/src/entries/timeline.d.ts",
      "import": "./dist/esm/timeline.js"
    },
    "./datepicker": {
      "types": "./dist/src/entries/datepicker.d.ts",
      "import": "./dist/esm/datepicker.js"
    },
    "./range-slider": {
      "types": "./dist/src/entries/range-slider.d.ts",
      "import": "./dist/esm/range-slider.js"
    },
    "./data-table": {
      "types": "./dist/src/entries/data-table.d.ts",
      "import": "./dist/esm/data-table.js"
    },
    "./component-registry": {
      "types": "./dist/src/entries/component-registry.d.ts",
      "import": "./dist/esm/component-registry.js"
    },
    "./sanitize": {
      "types": "./dist/src/entries/sanitize.d.ts",
      "import": "./dist/esm/sanitize.js"
    }
  },
  "files": [
    "dist/amphibious.css",
    "dist/amphibious.es.js",
    "dist/amphibious.umd.js",
    "dist/esm/**/*.js",
    "dist/src/**/*.d.ts",
    "src/css/**/*.css",
    "src/js/**/*.ts",
    "src/js/**/*.js",
    "src/entries/**/*.ts",
    "src/utils/**/*.ts",
    "src/loaders.ts",
    "src/index.ts"
  ],
  "scripts": {
    "dev": "vite --config vite.config.app.js --port 2960 --host",
    "build": "NODE_ENV=production vite build && vite build --config vite.config.lib-esm.js && tsc --emitDeclarationOnly --outDir dist",
    "build:esm": "NODE_ENV=production vite build --config vite.config.lib-esm.js",
    "build:site": "NODE_ENV=production vite build && node scripts/build-site.js",
    "build:analyze": "ANALYZE=true NODE_ENV=production vite build",
    "build:watch": "NODE_ENV=production vite build --watch",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome check . --linter-enabled=false --assist-enabled=false",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./test/setup.ts",
    "test:watch": "bun test --watch --preload ./test/setup.ts",
    "clean": "rm -rf dist",
    "clean:all": "rm -rf dist node_modules bun.lockb",
    "fix:grid": "bun run scripts/fix-grid.ts",
    "fix:images": "bun run scripts/update-image-placeholders.ts",
    "fix:docs": "bun run scripts/fix-docs.ts"
  },
  "keywords": [
    "css",
    "framework",
    "responsive",
    "grid",
    "components",
    "boilerplate",
    "html5"
  ],
  "author": {
    "name": "Clive Moore",
    "url": "https://clivemoore.ca"
  },
  "sideEffects": [
    "*.css",
    "./src/index.ts",
    "./src/js/navigation.ts",
    "./src/js/dark-mode-toggle.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agency-In-a-box/amphibious.git"
  },
  "homepage": "https://github.com/agency-In-a-box/amphibious#readme",
  "bugs": {
    "url": "https://github.com/agency-In-a-box/amphibious/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.0.2",
    "axe-core": "^4.11.1",
    "cssnano": "^7.1.2",
    "happy-dom": "^20.0.11",
    "postcss": "^8.5.6",
    "postcss-preset-env": "^10.5.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.80.7",
    "terser": "^5.44.1",
    "typescript": ">=5.0.0",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "dompurify": "^3.3.1"
  }
}
